//////////////////////////////////////////////////////
// INTEGRATIONS
//////////////////////////////////////////////////////

enum IntegrationType {
  BILLING
  ECOMMERCE
  POS
  ERP
  PAYMENT
  CUSTOM
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
}

model Integration {
  id        Int    @id @default(autoincrement())
  companyId Int
  name      String
  provider  String?
  type      IntegrationType

  webhookKey    String? @unique
  webhookSecret String?

  // ------------------------------------------
  // AUTOMATION SETTINGS
  // ------------------------------------------
  // Controls what happens automatically when a
  // webhook event is received. Shape:
  // {
  //   autoCreateCustomer: boolean,   // create a NEW customer if phone not found
  //   autoCreatePurchase: boolean,   // record a Purchase row
  //   allowedEventTypes: string[]    // [] = allow all event types
  // }
  // Always read through getIntegrationSettings()
  // helper so missing/partial settings fall back
  // to safe defaults.
  // ------------------------------------------
  settings Json?

  status IntegrationStatus @default(ACTIVE)

  lastEventAt DateTime?
  lastSyncAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events    IntegrationEvent[]
  purchases Purchase[]

  @@index([companyId])
  @@index([status])
}

model IntegrationEvent {
  id Int @id @default(autoincrement())

  integrationId Int

  eventId   String
  eventType String

  payload Json

  status       String @default("RECEIVED")
  errorMessage String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, eventId])
  @@index([integrationId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model Purchase {
  id Int @id @default(autoincrement())

  companyId  Int
  customerId String

  integrationId Int?

  externalOrderId String?
  invoiceNumber   String?

  amount   Float
  currency String @default("INR")

  status String

  purchaseDate DateTime

  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@index([integrationId])
  @@index([externalOrderId])
  @@index([purchaseDate])
}

//////////////////////////////////////////////////////
// FACEBOOK PAGE (Messenger)
//////////////////////////////////////////////////////

model FacebookPage {
  id Int @id @default(autoincrement())

  companyId Int

  // Facebook's own Page ID. Meta webhooks tell us which Page a message
  // belongs to, so this is how we find the company.
  pageId   String  @unique
  pageName String?

  // Instagram professional account linked to this Page (null if none).
  // Instagram webhooks identify the account by this ID.
  instagramAccountId String? @unique
  instagramUsername  String?

  // FACEBOOK_LOGIN  = connected through Facebook (Page, plus linked Instagram)
  // INSTAGRAM_LOGIN = Instagram connected directly, no Facebook needed.
  //                   (pageId is then "ig_<instagram id>" and
  //                    pageAccessToken holds the Instagram token)
  connectionType String @default("FACEBOOK_LOGIN")

  // INSTAGRAM_LOGIN only: when the 60-day Instagram token expires
  tokenExpiresAt DateTime?

  // Page access token, stored ENCRYPTED (see utils/secretCrypto.js).
  // null once the Page is disconnected.
  pageAccessToken String?

  // CONNECTED | RECONNECT_NEEDED | DISCONNECTED
  status String @default("CONNECTED")

  connectedByUserId String?

  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([companyId])
  @@index([status])
}

