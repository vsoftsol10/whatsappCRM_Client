generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////////////////////////////////////
// SUPER ADMIN
//////////////////////////////////////////////////////

model SuperAdmin {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
}

//////////////////////////////////////////////////////
// COMPANY
//////////////////////////////////////////////////////

model Company {
  id          Int    @id @default(autoincrement())
  companyId   String @unique
  companyName String
  logo        String?
  ownerName   String

  email   String @unique
  phone   String
  address String

  plan       String
  status     CompanyStatus @default(ACTIVE)
  expiryDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // WhatsApp Business connection
  whatsappAccounts WhatsAppAccount[]

  // Facebook Pages connected for Messenger
  facebookPages FacebookPage[]
  aiUsageLogs   AiUsageLog[]

  // SaaS
  subscriptions   Subscription[]
  supportTickets  SupportTicket[]
  payments        Payment[]

  // CRM
  users                        User[]
  customers                    Customer[]
  services                     Service[]
  conversations                Conversation[]
  campaigns                    Campaign[]
  templates                    Template[]
  leads                        Lead[]
  deals                        Deal[]
  tasks                        Task[]
  tickets                      Ticket[]
  employees                    Employee[]
  crmAuditLogs                 CrmAuditLog[]
  subscriptionUpgradeRequests  SubscriptionUpgradeRequest[]

  integrations Integration[]
  purchases    Purchase[]

  backups Backup[]

  // AI auto-reply configuration (one row per company)
  aiSettings AiSettings?

  // AI support chatbot
  chatbotTenantSetting ChatbotTenantSetting?
  chatbotConversations ChatbotConversation[]
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum WhatsAppStatus {
  NOT_CONNECTED
  CONNECTED
  DISCONNECTED
}

//////////////////////////////////////////////////////
// WHATSAPP ACCOUNT
//////////////////////////////////////////////////////

model WhatsAppAccount {
  id Int @id @default(autoincrement())

  companyId Int

  // Meta / WhatsApp Business information
  wabaId        String?
  phoneNumberId String? @unique

  whatsappBusinessName String?
  displayPhoneNumber   String?

  // Access token used to communicate with Meta
  whatsappAccessToken String?

  status WhatsAppStatus @default(NOT_CONNECTED)

  // ============================================
  // COEXISTENCE (WhatsApp Business App + Cloud API)
  // ============================================
  // true when this number was onboarded via the
  // "Connect a WhatsApp Business App" path in Embedded
  // Signup, instead of a brand-new Cloud API-only number.
  isCoexistence Boolean @default(false)

  // Mirrors Meta's is_on_biz_app / platform_type fields
  // (GET /{phone_number_id}?fields=is_on_biz_app,platform_type)
  isOnBizApp   Boolean @default(false)
  platformType String?

  // Progress of the one-time 24h post-onboarding sync.
  // Values used: NOT_STARTED | REQUESTED | IN_PROGRESS | COMPLETED | DECLINED | FAILED
  contactsSyncStatus String @default("NOT_STARTED")
  historySyncStatus  String @default("NOT_STARTED")

  contactsSyncRequestId String?
  historySyncRequestId  String?

  // Business must keep the WhatsApp Business App open until this
  // deadline, or Meta requires a full re-onboarding (24h window
  // from the moment Coexistence is connected).
  syncDeadline DateTime?

  connectedAt    DateTime?
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////
  // RELATIONS
  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  campaigns     Campaign[]
  templates     Template[]

  ///////////////////////////////////////
  // INDEXES
  ///////////////////////////////////////

  @@index([companyId])
  @@index([wabaId])
  @@index([status])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION ENUM
//////////////////////////////////////////////////////

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

//////////////////////////////////////////////////////
// PAYMENT ENUM
//////////////////////////////////////////////////////

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  CASH
  BANK_TRANSFER
  UPI
}

//////////////////////////////////////////////////////
// TICKET ENUM
//////////////////////////////////////////////////////

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

//////////////////////////////////////////////////////
// USER ENUM
//////////////////////////////////////////////////////

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

//////////////////////////////////////////////////////
// SUBSCRIPTION PLAN
//////////////////////////////////////////////////////

model SubscriptionPlan {
  id Int @id @default(autoincrement())

  planName String @unique

  price Float

  durationDays Int

  maxUsers     Int
  maxCustomers Int @default(100)
  maxCampaigns Int
  maxTemplates Int @default(20)

  features Json

  isTrial Boolean @default(false)

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////

  subscriptions Subscription[]
  payments      Payment[]

  currentPlanUpgradeRequests   SubscriptionUpgradeRequest[] @relation("CurrentPlan")
  requestedPlanUpgradeRequests SubscriptionUpgradeRequest[] @relation("RequestedPlan")
}

//////////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////////

model Subscription {
  id Int @id @default(autoincrement())

  companyId Int
  planId    Int

  startDate  DateTime
  expiryDate DateTime

  usersAtSubscriptionStart Int @default(0)

  status        SubscriptionStatus @default(ACTIVE)
  paymentStatus PaymentStatus      @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  reminders SubscriptionReminder[]
  payments  Payment[]

  @@index([companyId])
  @@index([planId])
}

model SubscriptionUpgradeRequest {
  id              Int @id @default(autoincrement())
  companyId       Int
  currentPlanId   Int
  requestedPlanId Int

  status UpgradeRequestStatus @default(PENDING)

  requestedBy String
  approvedBy  String?

  remarks         String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  currentPlan   SubscriptionPlan @relation("CurrentPlan", fields: [currentPlanId], references: [id])
  requestedPlan SubscriptionPlan @relation("RequestedPlan", fields: [requestedPlanId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([requestedPlanId])
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

//////////////////////////////////////////////////////
// SUBSCRIPTION REMINDER
//////////////////////////////////////////////////////

model SubscriptionReminder {
  id Int @id @default(autoincrement())

  subscriptionId Int

  channel String @default("EMAIL")

  recipientEmail String
  subject        String
  content        String

  status String @default("SENT")

  sentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

//////////////////////////////////////////////////////
// EMPLOYEE
//////////////////////////////////////////////////////

model Employee {
  id String @id @default(uuid())

  companyId Int?

  employeeId String @unique

  name     String
  email    String @unique
  password String

  phone   String?
  address String?

  role   String @default("EMPLOYEE")
  status String @default("ACTIVE")

  mustChangePassword Boolean @default(true)

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////////

  company Company? @relation(fields: [companyId], references: [id])

  notifications   Notification[]
  assignedTickets SupportTicket[]

  @@index([companyId])
}

//////////////////////////////////////////////////////
// SUPER ADMIN NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id Int @id @default(autoincrement())

  employeeId   String?
  superAdminId String?

  title   String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([superAdminId])
}

//////////////////////////////////////////////////////
// SUPPORT TICKET
//////////////////////////////////////////////////////

model SupportTicket {
  id Int @id @default(autoincrement())

  companyId  Int
  employeeId String?

  title       String
  description String

  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(OPEN)

  notes SupportTicketNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////////

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo Employee? @relation(fields: [employeeId], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id String @id @default(uuid())

  paymentId String @unique

  companyId      Int?
  subscriptionId Int?
  planId         Int?

  companyName String
  ownerName   String
  email       String
  phone       String

  amount      Float
  tax         Float @default(0)
  discount    Float @default(0)
  totalAmount Float

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus

  gateway String?

  transactionId String?
  invoiceNumber String?

  // Razorpay payment details
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company?          @relation(fields: [companyId], references: [id])
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id])
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([paymentStatus])
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(uuid())

  companyId Int

  name     String
  email    String
  password String

  role Role @default(USER)

  isFirstLogin Boolean @default(true)

  // NEW: set when the user finishes / skips the product tour (user guide),
  // so it is shown only once per account, not once per browser.
  tourSeenAt DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  address     String?
  department  String?
  designation String?
  phone       String?

  profileImage String?

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaigns  Campaign[]
  customers  Customer[]
  templates  Template[]

  assignedLeads  Lead[]         @relation("AssignedLeads")
  leadWorkNotes  LeadWorkNote[] @relation("LeadWorkNotes")

  assignedDeals Deal[] @relation("AssignedDeals")
  createdDeals  Deal[] @relation("CreatedDeals")

  dealActivities DealActivity[] @relation("CreatedDealActivities")

  notifications UserNotification[]

  backups Backup[]

  assignedTasks Task[]         @relation("AssignedTasks")
  createdTasks  Task[]         @relation("CreatedTasks")
  taskWorkNotes TaskWorkNote[] @relation("TaskWorkNotes")

  assignedTickets Ticket[]         @relation("AssignedTickets")
  createdTickets  Ticket[]         @relation("CreatedTickets")
  ticketWorkNotes TicketWorkNote[] @relation("TicketWorkNotes")

  ///////////////////////////////////////

  @@unique([companyId, email])
  @@index([companyId])
}

//////////////////////////////////////////////////////
// CUSTOMER
//////////////////////////////////////////////////////

model Customer {
  id String @id @default(uuid())

  companyId Int

  name        String
  phone       String
  email       String?
  companyName String?

  status String @default("ACTIVE")

  userId String

  requirements String?
  source       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  conversations       Conversation?
  campaignRecipients  CampaignRecipient[]
  templateRecipients  TemplateRecipient[]
  deals               Deal[]
  tickets             Ticket[]
  purchases           Purchase[]

  // Services this customer uses (optional, many-to-many)
  customerServices CustomerService[]

  ///////////////////////////////////////

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// SERVICE (per company) + CUSTOMER <-> SERVICE
//////////////////////////////////////////////////////

// A service/product line that a company offers (e.g. "Yoga", "Web Design").
// Used to tag customers so campaigns can target one service's customers.
model Service {
  id String @id @default(uuid())

  companyId Int

  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers CustomerService[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Join table: one customer can use many services, one service has many customers.
model CustomerService {
  customerId String
  serviceId  String

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([customerId, serviceId])
  @@index([serviceId])
}

//////////////////////////////////////////////////////
// CONVERSATION
//////////////////////////////////////////////////////

model Conversation {
  id String @id @default(uuid())

  companyId Int

  customerId String? @unique

  whatsappAccountId Int?

  phone String?

  // FACEBOOK MESSENGER (all null for WhatsApp conversations)
  // channel = "MESSENGER" for these conversations.
  facebookPageId Int?
  externalUserId String? // the person's Page-Scoped ID (PSID)
  contactName    String? // name shown when there is no linked customer

  status  String @default("OPEN")
  channel String @default("WHATSAPP")

  lastMessage String?
  unreadCount Int    @default(0)

  welcomeSent Boolean @default(false)

  // AI AUTO-REPLY (Grok)
  // Per-conversation toggle. Defaults ON; auto-flipped to false the
  // moment an AGENT sends a manual reply so bot and human don't clash.
  botEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id])
  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  facebookPage    FacebookPage?    @relation(fields: [facebookPageId], references: [id], onDelete: SetNull)

  messages Message[]

  ///////////////////////////////////////

  @@index([companyId])
  @@index([companyId, updatedAt]) // chat list: filter by company, newest first
  @@index([whatsappAccountId])
  @@index([facebookPageId])
  @@unique([facebookPageId, externalUserId])
}

//////////////////////////////////////////////////////
// MESSAGE
//////////////////////////////////////////////////////

model Message {
  id String @id @default(uuid())

  conversationId String

  content String
  sender  String

  messageType String @default("TEXT")
  status      String @default("SENT")

  imageUrl String?

  // The template's buttons (call / website / quick reply / copy code),
  // saved with a template message so the chat can show them. Null for
  // normal messages.
  buttons Json?

  metaMessageId String? @unique

  failureReason String?
  isEdited      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt]) // open chat: messages in time order
}

//////////////////////////////////////////////////////
// USER NOTIFICATION (CRM)
//////////////////////////////////////////////////////

model UserNotification {
  id Int @id @default(autoincrement())

  userId String

  title   String
  message String
  type    NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  ///////////////////////////////////////

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

//////////////////////////////////////////////////////
// LEAD
//////////////////////////////////////////////////////

model Lead {
  id Int @id @default(autoincrement())

  companyId Int

  name        String
  phone       String?
  email       String?
  companyName String?

  source       String?
  requirements String?

  status LeadStatus

  isConverted Boolean @default(false)

  assignedToId String?

  // Facebook / Instagram leads created by the AI (both optional)
  channel        String? // "MESSENGER" or "INSTAGRAM"
  conversationId String? // the chat this lead came from

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  workNotes LeadWorkNote[]

  @@index([companyId])
  @@index([assignedToId])
  @@index([companyId, conversationId])
}

//////////////////////////////////////////////////////
// LEAD WORK NOTE
//////////////////////////////////////////////////////

model LeadWorkNote {
  id String @id @default(uuid())

  leadId     Int
  employeeId String

  note String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  lead     Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee User @relation("LeadWorkNotes", fields: [employeeId], references: [id])

  @@index([leadId])
  @@index([employeeId])
}

//////////////////////////////////////////////////////
// CAMPAIGN
//////////////////////////////////////////////////////

model Campaign {
  id String @id @default(uuid())

  companyId Int

  whatsappAccountId Int?

  name String
  type CampaignType

  // WhatsApp template used by this campaign
  templateId String?

  // Optional custom message for future use
  messageContent String?

  status CampaignStatus @default(DRAFT)

  // Audience
  audienceCount Int @default(0)

  // Campaign scheduling
  scheduledAt DateTime?

  // Actual execution times
  startedAt   DateTime?
  completedAt DateTime?

  // Campaign statistics
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  deliveredCount  Int @default(0)
  readCount       Int @default(0)
  failedCount     Int @default(0)

  // Optional media
  imageUrl String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////
  // RELATIONS
  ///////////////////////////////////////

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  createdBy       User             @relation(fields: [createdById], references: [id])
  template        Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)

  recipients CampaignRecipient[]

  ///////////////////////////////////////
  // INDEXES
  ///////////////////////////////////////

  @@index([companyId])
  @@index([whatsappAccountId])
  @@index([createdById])
  @@index([templateId])
  @@index([status])
  @@index([scheduledAt])
}

//////////////////////////////////////////////////////
// CAMPAIGN RECIPIENT
//////////////////////////////////////////////////////

model CampaignRecipient {
  id String @id @default(uuid())

  campaignId String
  customerId String

  status RecipientStatus @default(PENDING)

  // WhatsApp message ID
  whatsappMessageId String?

  // Delivery timestamps
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  // Failure information
  failureReason String?

  createdAt DateTime @default(now())

  ///////////////////////////////////////
  // RELATIONS
  ///////////////////////////////////////

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  ///////////////////////////////////////
  // INDEXES
  ///////////////////////////////////////

  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@index([customerId])
  @@index([status])
}

//////////////////////////////////////////////////////
// TEMPLATE
//////////////////////////////////////////////////////

model Template {
  id String @id @default(uuid())

  companyId Int

  whatsappAccountId Int?

  name     String
  language String @default("en_US")

  category    TemplateCategory
  messageType MessageType      @default(TEXT)

  content String

  headerType    HeaderType @default(NONE)
  headerContent String?
  footerContent String?

  // Sample values for {{1}}, {{2}}, etc. in `content`.
  // Stored as a JSON array in the same order as the variable numbers,
  // e.g. ["Rahul", "ORD1234"] for {{1}} and {{2}}.
  bodyExamples Json?

  // Buttons shown under the message (call / website / quick reply /
  // copy code). Stored as a JSON array, e.g.
  // [{ "type": "URL", "text": "Pay Now", "url": "https://..." }]
  buttons Json?

  status TemplateStatus @default(DRAFT)

  purpose  TemplatePurpose @default(CUSTOM)
  autoSend Boolean         @default(false)

  metaTemplateId  String?
  rejectionReason String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  createdBy       User             @relation(fields: [createdById], references: [id])

  recipients TemplateRecipient[]
  campaigns  Campaign[]

  @@unique([companyId, name, language])
  @@index([companyId])
  @@index([whatsappAccountId])
  @@index([createdById])
  @@index([metaTemplateId])
}

//////////////////////////////////////////////////////
// TEMPLATE RECIPIENT
//////////////////////////////////////////////////////

model TemplateRecipient {
  id String @id @default(uuid())

  templateId String
  customerId String

  status RecipientStatus @default(PENDING)

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  metaMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([templateId, customerId])
  @@index([templateId])
  @@index([customerId])
}

//////////////////////////////////////////////////////
// DEAL
//////////////////////////////////////////////////////

model Deal {
  id String @id @default(uuid())

  companyId Int

  title       String
  description String?

  value Float     @default(0)
  stage DealStage @default(LEAD)

  customerId   String
  createdById  String
  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id])
  createdBy  User     @relation("CreatedDeals", fields: [createdById], references: [id])
  assignedTo User?    @relation("AssignedDeals", fields: [assignedToId], references: [id])

  activities DealActivity[]

  @@index([companyId])
  @@index([customerId])
  @@index([createdById])
  @@index([assignedToId])
}

//////////////////////////////////////////////////////
// DEAL ACTIVITY
//////////////////////////////////////////////////////

model DealActivity {
  id String @id @default(uuid())

  dealId String

  type String
  note String

  createdById String

  createdAt DateTime @default(now())

  ///////////////////////////////////////

  deal      Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy User @relation("CreatedDealActivities", fields: [createdById], references: [id])

  @@index([dealId])
  @@index([createdById])
}

//////////////////////////////////////////////////////
// TASK
//////////////////////////////////////////////////////

model Task {
  id String @id @default(uuid())

  companyId Int

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate DateTime?

  createdById  String
  assignedToId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedTo User    @relation("AssignedTasks", fields: [assignedToId], references: [id])

  workNotes TaskWorkNote[]

  @@index([companyId])
  @@index([createdById])
  @@index([assignedToId])
}

//////////////////////////////////////////////////////
// TASK WORK NOTE
//////////////////////////////////////////////////////

model TaskWorkNote {
  id String @id @default(uuid())

  taskId     String
  employeeId String

  note String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee User @relation("TaskWorkNotes", fields: [employeeId], references: [id])

  @@index([taskId])
  @@index([employeeId])
}

//////////////////////////////////////////////////////
// CRM TICKET
//////////////////////////////////////////////////////

model Ticket {
  id String @id @default(uuid())

  companyId Int

  title       String
  description String?

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  customerId   String
  createdById  String
  assignedToId String?

