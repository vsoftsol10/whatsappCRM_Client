generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////////////////////////////////////
// SUPER ADMIN
//////////////////////////////////////////////////////

model SuperAdmin {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
}

//////////////////////////////////////////////////////
// COMPANY
//////////////////////////////////////////////////////

model Company {
  id            Int      @id @default(autoincrement())
  companyId     String   @unique

  companyName   String
  ownerName     String

  email         String   @unique
  phone         String
  address       String

  plan          String
  status        CompanyStatus @default(ACTIVE)
  expiryDate    DateTime

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // WhatsApp Business connection
  whatsappAccounts WhatsAppAccount[]

  // SaaS
  subscriptions Subscription[]
  supportTickets SupportTicket[]
  payments Payment[]

  // CRM (add these)
  users User[]
  customers Customer[]
  conversations Conversation[]
  campaigns Campaign[]
  templates Template[]
  leads Lead[]
  deals Deal[]
  tasks Task[]
  tickets Ticket[]
  employees Employee[]
  crmAuditLogs CrmAuditLog[]
  subscriptionUpgradeRequests SubscriptionUpgradeRequest[]
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum WhatsAppStatus {
  NOT_CONNECTED
  CONNECTED
  DISCONNECTED
}

//////////////////////////////////////////////////////
// WHATSAPP ACCOUNT
//////////////////////////////////////////////////////

model WhatsAppAccount {
  id Int @id @default(autoincrement())

  companyId Int

  // Meta / WhatsApp Business information
  wabaId String?
  phoneNumberId String? @unique

  whatsappBusinessName String?
  displayPhoneNumber String?

  // Access token used to communicate with Meta
  whatsappAccessToken String?

  status WhatsAppStatus @default(NOT_CONNECTED)

  connectedAt DateTime?
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////
  // RELATIONS
  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  campaigns Campaign[]
  templates Template[]

  ///////////////////////////////////////
  // INDEXES
  ///////////////////////////////////////

  @@index([companyId])
  @@index([wabaId])
  @@index([status])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION ENUM
//////////////////////////////////////////////////////

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

//////////////////////////////////////////////////////
// PAYMENT ENUM
//////////////////////////////////////////////////////

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  CASH
  BANK_TRANSFER
  UPI
}

//////////////////////////////////////////////////////
// TICKET ENUM
//////////////////////////////////////////////////////

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

//////////////////////////////////////////////////////
// USER ENUM
//////////////////////////////////////////////////////

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

//////////////////////////////////////////////////////
// SUBSCRIPTION PLAN
//////////////////////////////////////////////////////

model SubscriptionPlan {
  id Int @id @default(autoincrement())

  planName String @unique

  price Float

  durationDays Int

  maxUsers Int
  maxCustomers Int @default(100)
  maxCampaigns Int
  maxTemplates Int @default(20)

  features Json

  isTrial Boolean @default(false)

  status String @default("ACTIVE")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////

  subscriptions Subscription[]

  payments Payment[]

 currentPlanUpgradeRequests   SubscriptionUpgradeRequest[] @relation("CurrentPlan")
  requestedPlanUpgradeRequests SubscriptionUpgradeRequest[] @relation("RequestedPlan")
}

//////////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////////

model Subscription {
  id Int @id @default(autoincrement())

  companyId Int

  planId Int

  startDate DateTime

  expiryDate DateTime

   usersAtSubscriptionStart Int @default(0)

  status SubscriptionStatus @default(ACTIVE)

  paymentStatus PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  reminders SubscriptionReminder[]

  payments Payment[]

  @@index([companyId])
  @@index([planId])
}

model SubscriptionUpgradeRequest {
  id              Int                  @id @default(autoincrement())
  companyId       Int
  currentPlanId   Int
  requestedPlanId Int

  status          UpgradeRequestStatus @default(PENDING)

  requestedBy     String
  approvedBy      String?

  remarks         String?
  rejectionReason String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  currentPlan     SubscriptionPlan @relation("CurrentPlan", fields: [currentPlanId], references: [id])

  requestedPlan   SubscriptionPlan @relation("RequestedPlan", fields: [requestedPlanId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([requestedPlanId])
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

//////////////////////////////////////////////////////
// SUBSCRIPTION REMINDER
//////////////////////////////////////////////////////

model SubscriptionReminder {
  id Int @id @default(autoincrement())

  subscriptionId Int

  channel String @default("EMAIL")

  recipientEmail String

  subject String

  content String

  status String @default("SENT")

  sentAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

//////////////////////////////////////////////////////
// EMPLOYEE
//////////////////////////////////////////////////////

model Employee {
  id String @id @default(uuid())

  companyId Int?

  employeeId String @unique

  name String

  email String @unique

  password String

  phone String?

  address String?

  role String @default("EMPLOYEE")

  status String @default("ACTIVE")

  mustChangePassword Boolean @default(true)

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////////

  company Company? @relation(fields: [companyId], references: [id])

  notifications Notification[]

  assignedTickets SupportTicket[]

  @@index([companyId])
}

//////////////////////////////////////////////////////
// SUPER ADMIN NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id Int @id @default(autoincrement())

  employeeId String?
  superAdminId String?

  title String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  employee Employee? @relation( fields: [employeeId], references: [id], onDelete: Cascade )

  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([superAdminId])
}
//////////////////////////////////////////////////////
// SUPPORT TICKET
//////////////////////////////////////////////////////

model SupportTicket {
  id Int @id @default(autoincrement())

  companyId Int

  employeeId String?

  title String

  description String

  priority TicketPriority @default(MEDIUM)

  status TicketStatus @default(OPEN)
  notes SupportTicketNote[]
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedTo Employee? @relation(fields: [employeeId], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id String @id @default(uuid())

  paymentId String @unique

  companyId Int?

  subscriptionId Int?

  planId Int?

  companyName String

  ownerName String

  email String

  phone String

  amount Float

  tax Float @default(0)

  discount Float @default(0)

  totalAmount Float

  paymentMethod PaymentMethod

  paymentStatus PaymentStatus

  gateway String?

  transactionId String?

  invoiceNumber String?

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////////

  company Company? @relation(fields: [companyId], references: [id])

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  plan SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([subscriptionId])
  @@index([planId])
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(uuid())

  companyId Int

  name String

  email String

  password String

  role Role @default(USER)

  isFirstLogin Boolean @default(true)

  resetToken String?

  resetTokenExpiry DateTime?

  address String?

  department String?

  designation String?

  phone String?

  profileImage String?

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaigns Campaign[]

  customers Customer[]

  assignedLeads Lead[] @relation("AssignedLeads")

  leadWorkNotes LeadWorkNote[] @relation("LeadWorkNotes")

  assignedDeals Deal[] @relation("AssignedDeals")

  createdDeals Deal[] @relation("CreatedDeals")

  dealActivities DealActivity[] @relation("CreatedDealActivities")

  notifications UserNotification[]

  assignedTasks Task[] @relation("AssignedTasks")

  createdTasks Task[] @relation("CreatedTasks")

  taskWorkNotes TaskWorkNote[] @relation("TaskWorkNotes")

  templates Template[]

  assignedTickets Ticket[] @relation("AssignedTickets")

  createdTickets Ticket[] @relation("CreatedTickets")

  ticketWorkNotes TicketWorkNote[] @relation("TicketWorkNotes")

  ///////////////////////////////////////

  @@unique([companyId, email])
  @@index([companyId])
}

//////////////////////////////////////////////////////
// CUSTOMER
//////////////////////////////////////////////////////

model Customer {
  id String @id @default(uuid())

  companyId Int

  name String

  phone String

  email String?

  companyName String?

  status String @default("ACTIVE")

  userId String

  requirements String?

  source String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  conversations Conversation?

  campaignRecipients CampaignRecipient[]

  templateRecipients TemplateRecipient[]

  deals Deal[]

  tickets Ticket[]

  ///////////////////////////////////////

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// CONVERSATION
//////////////////////////////////////////////////////

model Conversation {
  id String @id @default(uuid())

  companyId Int

  customerId String? @unique

  whatsappAccountId Int?

  phone String?

  status String @default("OPEN")

  channel String @default("WHATSAPP")

  lastMessage String?

  unreadCount Int @default(0)

  welcomeSent Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customer Customer? @relation(fields: [customerId], references: [id])

  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId],references: [id],onDelete: SetNull)

  messages Message[]

  ///////////////////////////////////////

  @@index([companyId])
  @@index([whatsappAccountId])
}

//////////////////////////////////////////////////////
// MESSAGE
//////////////////////////////////////////////////////

model Message {
  id String @id @default(uuid())

  conversationId String

  content String

  sender String

  messageType String @default("TEXT")

  status String @default("SENT")

  imageUrl String?

  metaMessageId String? @unique

  failureReason String?

  isEdited Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

//////////////////////////////////////////////////////
// USER NOTIFICATION (CRM)
//////////////////////////////////////////////////////

model UserNotification {
  id Int @id @default(autoincrement())

  userId String

  title String

  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  ///////////////////////////////////////

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

//////////////////////////////////////////////////////
// LEAD
//////////////////////////////////////////////////////

model Lead {
  id Int @id @default(autoincrement())

  companyId Int

  name String

  phone String?

  email String?

  companyName String?

  source String?

  requirements String?

  status LeadStatus

  isConverted Boolean @default(false)

  assignedToId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedTo User? @relation("AssignedLeads", fields: [assignedToId], references: [id])

  workNotes LeadWorkNote[]

  @@index([companyId])
  @@index([assignedToId])
}

//////////////////////////////////////////////////////
// LEAD WORK NOTE
//////////////////////////////////////////////////////

model LeadWorkNote {
  id String @id @default(uuid())

  leadId Int

  employeeId String

  note String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  employee User @relation("LeadWorkNotes", fields: [employeeId], references: [id])

  @@index([leadId])
  @@index([employeeId])
}

//////////////////////////////////////////////////////
// CAMPAIGN
//////////////////////////////////////////////////////

model Campaign {
  id String @id @default(uuid())

  companyId Int

  whatsappAccountId Int?

  name String

  type CampaignType

  // WhatsApp template used by this campaign
  templateId String?

  // Optional custom message for future use
  messageContent String?

  status CampaignStatus @default(DRAFT)

  // Audience
  audienceCount Int @default(0)

  // Campaign scheduling
  scheduledAt DateTime?

  // Actual execution times
  startedAt DateTime?
  completedAt DateTime?

  // Campaign statistics
  totalRecipients Int @default(0)
  sentCount Int @default(0)
  deliveredCount Int @default(0)
  readCount Int @default(0)
  failedCount Int @default(0)

  // Optional media
  imageUrl String?

  createdById String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////
  // RELATIONS
  ///////////////////////////////////////

  company Company @relation(fields: [companyId],references: [id], onDelete: Cascade)

  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)

  createdBy User @relation( fields: [createdById], references: [id] )

  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull )

  recipients CampaignRecipient[]

  ///////////////////////////////////////
  // INDEXES
  ///////////////////////////////////////

  @@index([companyId])
  @@index([whatsappAccountId])
  @@index([createdById])
  @@index([templateId])
  @@index([status])
  @@index([scheduledAt])
}

//////////////////////////////////////////////////////
// CAMPAIGN RECIPIENT
//////////////////////////////////////////////////////

model CampaignRecipient {
  id String @id @default(uuid())

  campaignId String

  customerId String

  status RecipientStatus @default(PENDING)

  // WhatsApp message ID
  whatsappMessageId String?

  // Delivery timestamps
  sentAt DateTime?
  deliveredAt DateTime?
  readAt DateTime?
  failedAt DateTime?

  // Failure information
  failureReason String?

  createdAt DateTime @default(now())

  ///////////////////////////////////////
  // RELATIONS
  ///////////////////////////////////////

  campaign Campaign @relation( fields: [campaignId],references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId],references: [id], onDelete: Cascade)

  ///////////////////////////////////////
  // INDEXES
  ///////////////////////////////////////

  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@index([customerId])
  @@index([status])
}

//////////////////////////////////////////////////////
// TEMPLATE
//////////////////////////////////////////////////////


model Template {
  id String @id @default(uuid())

  companyId Int

  whatsappAccountId Int?

  name String

  language String @default("en_US")

  category TemplateCategory

  messageType MessageType @default(TEXT)

  content String

  status TemplateStatus @default(DRAFT)

  purpose TemplatePurpose @default(CUSTOM)

  autoSend Boolean @default(false)

  createdById String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId],references: [id], onDelete: Cascade)

  whatsappAccount WhatsAppAccount? @relation( fields: [whatsappAccountId],references: [id], onDelete: SetNull)

  createdBy User @relation( fields: [createdById],references: [id])

  recipients TemplateRecipient[]
  campaigns Campaign[]
  
  @@unique([companyId, name, language])
  @@index([companyId])
  @@index([whatsappAccountId])
  @@index([createdById])
}

//////////////////////////////////////////////////////
// TEMPLATE RECIPIENT
//////////////////////////////////////////////////////

model TemplateRecipient {
  id String @id @default(uuid())

  templateId String

  customerId String

  status RecipientStatus @default(PENDING)

  sentAt DateTime?

  deliveredAt DateTime?

  readAt DateTime?

  metaMessageId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([templateId, customerId])
  @@index([templateId])
  @@index([customerId])
}

//////////////////////////////////////////////////////
// DEAL
//////////////////////////////////////////////////////

model Deal {
  id String @id @default(uuid())

  companyId Int

  title String

  description String?

  value Float @default(0)

  stage DealStage @default(LEAD)

  customerId String

  createdById String

  assignedToId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id])

  createdBy User @relation("CreatedDeals", fields: [createdById], references: [id])

  assignedTo User? @relation("AssignedDeals", fields: [assignedToId], references: [id])

  activities DealActivity[]

  @@index([companyId])
  @@index([customerId])
  @@index([createdById])
  @@index([assignedToId])
}

//////////////////////////////////////////////////////
// DEAL ACTIVITY
//////////////////////////////////////////////////////

model DealActivity {
  id String @id @default(uuid())

  dealId String

  type String

  note String

  createdById String

  createdAt DateTime @default(now())

  ///////////////////////////////////////

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdBy User @relation("CreatedDealActivities", fields: [createdById], references: [id])

  @@index([dealId])
  @@index([createdById])
}

//////////////////////////////////////////////////////
// TASK
//////////////////////////////////////////////////////

model Task {
  id String @id @default(uuid())

  companyId Int

  title String

  description String?

  status TaskStatus @default(TODO)

  priority TaskPriority @default(MEDIUM)

  dueDate DateTime?

  createdById String

  assignedToId String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdBy User @relation("CreatedTasks", fields: [createdById], references: [id])

  assignedTo User @relation("AssignedTasks", fields: [assignedToId], references: [id])

  workNotes TaskWorkNote[]

  @@index([companyId])
  @@index([createdById])
  @@index([assignedToId])
}

//////////////////////////////////////////////////////
// TASK WORK NOTE
//////////////////////////////////////////////////////

model TaskWorkNote {
  id String @id @default(uuid())

  taskId String

  employeeId String

  note String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  employee User @relation("TaskWorkNotes", fields: [employeeId], references: [id])

  @@index([taskId])
  @@index([employeeId])
}

//////////////////////////////////////////////////////
// CRM TICKET
//////////////////////////////////////////////////////

model Ticket {
  id String @id @default(uuid())

  companyId Int

  title String

  description String?

  status TicketStatus @default(OPEN)

  priority TicketPriority @default(MEDIUM)

  customerId String

  createdById String

  assignedToId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id])

  createdBy User @relation("CreatedTickets", fields: [createdById], references: [id])

  assignedTo User? @relation("AssignedTickets", fields: [assignedToId], references: [id])

  workNotes TicketWorkNote[]

  @@index([companyId])
  @@index([customerId])
  @@index([createdById])
  @@index([assignedToId])
}

//////////////////////////////////////////////////////
// TICKET WORK NOTE
//////////////////////////////////////////////////////

model TicketWorkNote {
  id String @id @default(uuid())

  ticketId String

  employeeId String

  note String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ////////////////////////////////////////////

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  employee User @relation("TicketWorkNotes", fields: [employeeId], references: [id])

  @@index([ticketId])
  @@index([employeeId])
}

//////////////////////////////////////////////////////
// LEAD
//////////////////////////////////////////////////////

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
}

//////////////////////////////////////////////////////
// CAMPAIGN
//////////////////////////////////////////////////////

enum CampaignType {
  PROMOTIONAL
  BROADCAST
  FOLLOW_UP
  ANNOUNCEMENT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

//////////////////////////////////////////////////////
// TEMPLATE
//////////////////////////////////////////////////////

enum TemplateCategory {
  MARKETING
  SUPPORT
  SALES
  UTILITY
  AUTHENTICATION
}

enum TemplatePurpose {
  WELCOME
  ORDER_CONFIRMATION
  ORDER_UPDATE
  PAYMENT_REMINDER
  APPOINTMENT_REMINDER
  SUPPORT_FOLLOW_UP
  FESTIVAL_GREETING
  PROMOTION
  CUSTOM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

//////////////////////////////////////////////////////
// TASK
//////////////////////////////////////////////////////

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

//////////////////////////////////////////////////////
// DEAL
//////////////////////////////////////////////////////

enum DealStage {
  LEAD
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

//////////////////////////////////////////////////////
// CRM NOTIFICATION
//////////////////////////////////////////////////////

enum NotificationType {
  LEAD
  TASK
  TICKET
  CUSTOMER
  DEAL
  CAMPAIGN
  SUBSCRIPTION
  SYSTEM
}
//////////////////////////////////////////////////////
// SUPPORT TICKET NOTE
//////////////////////////////////////////////////////

model SupportTicketNote {

  id String @id @default(uuid())
  supportTicketId Int
  note String
  createdById String
  createdByName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ///////////////////////////////////////

  supportTicket SupportTicket @relation( fields:[supportTicketId],references:[id],onDelete:Cascade)
  
  @@index([supportTicketId])
}

//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(uuid())

  // Who performed the action
  actorId String?
  actorType String?
  actorName String?
  // What action was performed
  action String

  // What was affected
  entityType String
  entityId String?

  // Related company, if applicable
  companyId Int?

  // Human-readable description
  description String?

  // Data before and after the change
  oldValue Json?
  newValue Json?

  // Request information
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([companyId])
  @@index([createdAt])
}

model CrmAuditLog {
  id Int @id @default(autoincrement())

  companyId Int

  userId String?
  userName String
  userRole String

  action CrmAuditAction
  module CrmAuditModule

  entityId String?
  entityName String?

  changes Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  ///////////////////////////////////////

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([module])
  @@index([createdAt])
  @@index([companyId, module, createdAt])
  @@map("crm_audit_logs")
}

enum CrmAuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  ASSIGN

  @@map("CrmAuditAction")
}

enum CrmAuditModule {
  CUSTOMER
  EMPLOYEE
  LEAD
  DEAL
  TASK
