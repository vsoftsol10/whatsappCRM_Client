//////////////////////////////////////////////////////
// AI SETTINGS (Multi-provider AI Auto-Reply)
//////////////////////////////////////////////////////

// One row PER COMPANY. Each company brings its own AI provider and
// API key (Gemini, Grok, OpenAI, Claude, DeepSeek, Groq, Mistral or
// any OpenAI-compatible endpoint).
//
//  - companyId     : optional + unique. A row with companyId = null can
//                    hold the OLD single global Grok row (provider GROK,
//                    model grok-4, apiKey) from the Super Admin schema.
//  - isEnabled     : company-wide master switch. Each Conversation's
//                    own botEnabled still decides per chat.
//  - provider      : the ACTIVE provider id (GEMINI, GROK, OPENAI,
//                    ANTHROPIC, DEEPSEEK, GROQ, MISTRAL, CUSTOM)
//  - providerKeys  : { "GEMINI": "enc:v1:...", "OPENAI": "enc:v1:..." }
//                    API keys are stored ENCRYPTED (AES-256-GCM), one
//                    per provider, so switching providers never needs
//                    the key to be pasted again.
//  - baseUrl       : only used by the CUSTOM provider
//  - apiKey        : DEPRECATED legacy column from the old global
//                    Grok-only setup. No longer read or written.
model AiSettings {
  id Int @id @default(autoincrement())

  companyId Int?     @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(false)

  provider     String @default("GEMINI")
  model        String @default("gemini-2.5-flash")
  providerKeys Json?
  baseUrl      String?

  apiKey String?

  systemPrompt String @default("You are a helpful, friendly customer support assistant for this business. Keep replies short, clear, and polite. If you don't know the answer or the customer wants a human, say you'll connect them to the team.")

  // Structured business details the AI prompt is built from:
  // { businessName, description, workingHours, location, contact,
  //   languages, policies, tone }. The text above stays as extra instructions.
  businessProfile Json?

  // How many previous messages (both sides) to send as context
  historyLimit Int @default(10)

  leadCaptureEnabled Boolean @default(false)
  leadAssigneeId     String?

  // true = new leads are shared between all active employees automatically
  // (the one who got a lead longest ago gets the next one)
  leadAutoAssign Boolean @default(false)

  // Last failure of the auto-reply pipeline, shown on the settings page
  lastError   String?
  lastErrorAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id           Int               @id @default(autoincrement())
  customerName String
  designation  String?
  companyName  String?
  content      String
  rating       Int               @default(5)
  status       TestimonialStatus @default(DRAFT)
  displayOrder Int               @default(0)
  isFeatured   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

enum TestimonialStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

