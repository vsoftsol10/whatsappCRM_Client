//////////////////////////////////////////////////////
// AI SUPPORT CHATBOT (managed by Super Admin, used by client CRM)
// NOTE: separate from AiSettings, which is the per-company
// auto-reply to WhatsApp customers.
//////////////////////////////////////////////////////

// One row only (id = 1): provider, model, key, global instructions, limits
model ChatbotConfig {
  id Int @id @default(1)

  isEnabled Boolean @default(false)

  provider  String  @default("GROQ")
  model     String  @default("llama-3.3-70b-versatile")
  apiKeyEnc String? // AES-256-GCM encrypted, never sent to browsers

  botName            String   @default("CRM Assistant")
  welcomeMessage     String?
  globalInstructions String?
  suggestedQuestions String[] @default([])

  temperature     Float @default(0.2)
  maxOutputTokens Int   @default(700)
  historyLimit    Int   @default(6)
  topK            Int   @default(5)

  // 0 = unlimited
  defaultMonthlyTokenLimit Int @default(300000)
  defaultDailyUserMessages Int @default(30)
  globalMonthlyTokenLimit  Int @default(0)

  // Price per 1,000,000 tokens (used only for cost monitoring)
  inputPricePerM  Float  @default(0)
  outputPricePerM Float  @default(0)
  currency        String @default("USD")

  updatedAt DateTime @updatedAt
}

model KnowledgeDoc {
  id Int @id @default(autoincrement())

  title       String
  category    String  @default("General")
  content     String
  isPublished Boolean @default(false)
  version     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@index([isPublished])
}

model KnowledgeChunk {
  id Int @id @default(autoincrement())

  docId    Int
  position Int
  content  String

  createdAt DateTime @default(now())

  doc KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
}

// Optional per-company override. No row = enabled with default limits.
model ChatbotTenantSetting {
  id Int @id @default(autoincrement())

  companyId Int @unique

  isEnabled Boolean @default(true)

  monthlyTokenLimit     Int? // null = use default, 0 = unlimited
  dailyUserMessageLimit Int? // null = use default, 0 = unlimited

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ChatbotConversation {
  id String @id @default(uuid())

  companyId Int
  userId    String
  title     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages ChatbotMessage[]

  @@index([companyId])
  @@index([userId, updatedAt])
}

model ChatbotMessage {
  id Int @id @default(autoincrement())

  conversationId String
  companyId      Int
  userId         String

  role     String // "user" | "assistant"
  content  String
  question String? // assistant rows: the question that was answered

  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)
  cost             Float   @default(0)
  model            String?

  sources  Json?
  answered Boolean @default(true) // false = AI had no answer in the docs
  feedback Int? // 1 = helpful, -1 = not helpful

  createdAt DateTime @default(now())

  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([answered, createdAt])
}
